APP_NAME="KLTN API"
APP_ENV=development
LIVEKIT_URL=ws://localhost:7880
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
POSTGRES_USER=kltn
POSTGRES_PASSWORD=local_example_password
POSTGRES_DB=kltn
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://kltn:local_example_password@127.0.0.1:5432/kltn
FRONTEND_URL=http://localhost:3000
UVICORN_HOST=127.0.0.1
UVICORN_PORT=8000

# Generate a random local key; never commit the actual value.
JWT_SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
REFRESH_COOKIE_NAME=refresh_token
COOKIE_SECURE=false

# Docker Compose MinIO; backend runs on the Windows host.
# Replace credentials locally; never commit real values.
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
OBJECT_STORAGE_ACCESS_KEY=replace_with_local_access_key
OBJECT_STORAGE_SECRET_KEY=replace_with_local_secret_key
OBJECT_STORAGE_BUCKET=chat-attachments
OBJECT_STORAGE_SECURE=false
ATTACHMENT_MAX_SIZE_BYTES=26214400
# Dedicated empty PostgreSQL database for foundation tests; never use kltn here.
TEST_DATABASE_URL=postgresql+asyncpg://kltn:local_example_password@127.0.0.1:5432/kltn_test
